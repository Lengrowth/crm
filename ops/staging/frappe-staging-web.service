[Unit]
Description=LenERP staging ERP web
After=network-online.target frappe-staging-redis-cache.service frappe-staging-redis-queue.service
Wants=network-online.target

[Service]
Type=simple
User=frappe
Group=frappe
WorkingDirectory=/opt/frappe-staging-bench/sites
Environment=PATH=/opt/frappe-staging-bench/env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/frappe-staging-bench/env/bin/gunicorn -b 127.0.0.1:28000 -w 2 --max-requests 1000 --max-requests-jitter 100 -t 120 --graceful-timeout 30 frappe.app:application --preload
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
