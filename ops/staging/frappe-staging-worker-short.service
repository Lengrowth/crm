[Unit]
Description=LenERP staging ERP short worker
After=network-online.target frappe-staging-redis-queue.service
Wants=network-online.target

[Service]
Type=simple
User=frappe
Group=frappe
WorkingDirectory=/opt/frappe-staging-bench
Environment=PATH=/opt/frappe-staging-bench/env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/local/bin/bench worker --queue short,default
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
