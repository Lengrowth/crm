APP_NAME="SaaS Control Backend"
PRODUCT_NAME=LenERP
ENVIRONMENT=staging
RELEASE_MANIFEST_PATH=/opt/saas-control-staging/current/release-manifest.json
FEATURE_FLAGS=platform_phase1_shell=off
API_HOST=127.0.0.1
API_PORT=18001
FRONTEND_BASE_URL=http://staging.example.test
CORS_ORIGINS=http://staging.example.test,http://127.0.0.1:13001
DATABASE_URL=sqlite:////opt/saas-control-staging/shared/data/control-plane-staging.db
ERPNEXT_MODE=bench
ERPNEXT_BENCH_ROOT=/opt/frappe-staging-bench
ERPNEXT_BENCH_SITE_PREFIX=phase4-
ERPNEXT_BENCH_RUN_AS_USER=frappe
ERPNEXT_BENCH_COMMAND=/usr/local/bin/bench
ERPNEXT_BENCH_WEB_URL=http://127.0.0.1:28000
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
REQUIRE_AUTH_SMOKE=true
AUTH_TOKEN_FILE=/run/saas-control-staging/smoke/auth-token
BACKEND_SERVICE=saas-control-staging-backend
FRONTEND_SERVICE=saas-control-staging-frontend
STAGING_BASE_URL=http://127.0.0.1:13001
STAGING_BACKEND_URL=http://127.0.0.1:18001
