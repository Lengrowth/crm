[Unit]
Description=LenERP SaaS staging frontend
After=network-online.target saas-control-staging-backend.service
Wants=network-online.target

[Service]
Type=simple
User=saas-staging
Group=saas-staging
WorkingDirectory=/opt/saas-control-staging/current/frontend
EnvironmentFile=/opt/saas-control-staging/shared/env/staging-frontend.env
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 13000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
