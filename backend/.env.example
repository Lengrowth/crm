# Example env for local development
DATABASE_URL=sqlite:///saas_control.db

# Billing settings (phase 09)
BILLING_DEFAULT_CURRENCY=USD
BILLING_INVOICE_DUE_DAYS=14
# Placeholder for a provider key. Do NOT commit secrets. Leave blank for local testing.
STRIPE_API_KEY=
BILLING_PROVIDER=mock
BILLING_ALLOW_MOCK_IN_NON_LOCAL=false
BILLING_WEBHOOK_SECRET=

# Phase 19 hardening settings
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Phase 20 auth hardening settings
AUTH_SESSION_DAYS=30
AUTH_PASSWORD_RESET_TOKEN_MINUTES=60
AUTH_EMAIL_VERIFICATION_TOKEN_HOURS=24
FRONTEND_BASE_URL=http://localhost:3000
